{% set t = en if lang == "en" else fr %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ t.meta.title }}</title>
<meta name="theme-color" content="#0a0a0a" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="description" content="{{ t.meta.description }}" />
<link rel="canonical" href="{{ site.origin }}/{{ lang }}/" />
<link rel="alternate" hreflang="en" href="{{ site.origin }}/en/" />
<link rel="alternate" hreflang="fr" href="{{ site.origin }}/fr/" />
<link rel="alternate" hreflang="x-default" href="{{ site.origin }}/" />
<meta property="og:type" content="website" />
<meta property="og:title" content="{{ t.meta.ogTitle }}" />
<meta property="og:description" content="{{ t.meta.ogDescription }}" />
<meta property="og:url" content="{{ site.origin }}/{{ lang }}/" />
<meta property="og:image" content="{{ site.origin }}/og.png" />
<meta property="og:locale" content="{{ 'en_CA' if lang == 'en' else 'fr_CA' }}" />
<meta property="og:locale:alternate" content="{{ 'fr_CA' if lang == 'en' else 'en_CA' }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ t.meta.ogTitle }}" />
<meta name="twitter:description" content="{{ t.meta.ogDescription }}" />
<meta name="twitter:image" content="{{ site.origin }}/og.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Major+Mono+Display&family=Newsreader:opsz,wght,ital@6..72,400,0;6..72,400,1&family=IBM+Plex+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
{% raw %}<script>
  // Apply persisted theme before first paint, to avoid flash.
  (() => {
    try {
      const t = localStorage.getItem('atomstar-theme');
      if (t === 'dark' || t === 'light') {
        document.documentElement.dataset.theme = t;
      }
    } catch (e) {}
  })();
</script>{% endraw %}
{% raw %}<style>
  :root {
    /* brand pigments — never reassigned */
    --phosphor: #ff7a1a;
    --phosphor-dim: #b34d00;
    --carbon: #0a0a0a;
    --bone: #efe7d6;
    --fission: #ff2d2d;

    /* role tokens — DARK is the default */
    --bg: var(--carbon);
    --fg: var(--bone);
    --bg-deep: #000000;
    --dim: rgba(239, 231, 214, 0.5);
    --rule: rgba(239, 231, 214, 0.12);
    --bar-bg: rgba(10, 10, 10, 0.85);
    --accent: var(--phosphor);
    --accent-on: var(--carbon);
    --mark-stroke: var(--phosphor);
  }

  /* LIGHT — bone bg, darker phosphor for contrast */
  [data-theme="light"] {
    --bg: var(--bone);
    --fg: var(--carbon);
    --bg-deep: #e4dcc4;
    --dim: rgba(10, 10, 10, 0.55);
    --rule: rgba(10, 10, 10, 0.14);
    --bar-bg: rgba(239, 231, 214, 0.85);
    --accent: var(--phosphor-dim);
    --accent-on: var(--bone);
    --mark-stroke: var(--phosphor-dim);
  }

  html { transition: background 0.25s ease, color 0.25s ease; }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--bg);
    color: var(--fg);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 13px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  em { color: var(--accent); font-style: italic; }
  ::selection { background: var(--accent); color: var(--accent-on); }

  /* ─── Top minimal bar ─── */
  .top {
    padding: 22px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    position: sticky;
    top: 0;
    background: var(--bar-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 40;
  }
  .top .brand { color: var(--accent); letter-spacing: 0.25em; font-weight: 500; }
  .top nav { display: flex; gap: 22px; margin-left: auto; }
  .top nav a:hover { color: var(--fg); }

  /* theme toggle */
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--rule);
    padding: 6px 10px;
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .theme-toggle:hover { border-color: var(--accent); }
  .theme-toggle .sep { opacity: 0.4; }
  .theme-toggle .active { color: var(--accent); }
  /* language switch — same metrics as .theme-toggle */
  .lang-switch {
    border: 1px solid var(--rule);
    padding: 6px 10px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    display: inline-flex;
    align-items: center;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .lang-switch:hover { border-color: var(--accent); color: var(--accent); }

  /* ─── HERO / typewriter ─── */
  .hero {
    min-height: 88vh;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    position: relative;
    overflow: hidden;
  }
  .hero .eyebrow {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero .eyebrow::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    border-radius: 50%;
    animation: pulse 1.6s steps(2, end) infinite;
  }
  @keyframes pulse { 50% { opacity: 0.2; } }

  /* mark — atom icon + wordmark, horizontal */
  .mark {
    display: flex;
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    opacity: 0;
    animation: fade-in 0.8s ease-out 0.2s forwards;
  }
  @keyframes fade-in { to { opacity: 1; } }

  .atom {
    width: clamp(140px, 18vw, 280px);
    height: clamp(140px, 18vw, 280px);
    flex-shrink: 0;
  }
  .atom .ring  { fill: none; stroke: var(--mark-stroke); stroke-width: 2; }
  .atom .orbit { fill: none; stroke: var(--mark-stroke); stroke-width: 1.5; opacity: 0.85; }
  .atom .core  { fill: var(--accent); }
  /* three orbits, each spinning at its own pace — gives a 3-body feel */
  .atom .o1 { transform-origin: 50% 50%; animation: orbit-a 14s linear infinite; }
  .atom .o2 { transform-origin: 50% 50%; animation: orbit-a 10s linear infinite reverse; }
  .atom .o3 { transform-origin: 50% 50%; animation: orbit-a 18s linear infinite; }
  @keyframes orbit-a { to { transform: rotate(360deg); } }

  .wordmark {
    font-family: 'Major Mono Display', 'IBM Plex Mono', monospace;
    font-size: clamp(48px, 9vw, 132px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--fg);
    font-weight: 400;
  }
  .wordmark .accent { color: var(--accent); }

  .hero .sub {
    margin-top: 8px;
    font-family: 'Newsreader', serif;
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.45;
    max-width: 640px;
    opacity: 0;
    transform: translateX(-30px);
    animation: slidein 0.8s ease-out 1s forwards;
  }
  @keyframes slidein { to { opacity: 1; transform: translateX(0); } }

  /* hairline at hero bottom that draws horizontally */
  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--accent);
    width: 0;
    animation: draw 1.4s ease-out 1.4s forwards;
  }
  @keyframes draw { to { width: 100%; } }

  /* ─── Marquee ─── */
  .marquee {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 18px 0;
    overflow: hidden;
    background: var(--bg-deep);
    position: relative;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 64px;
    width: max-content;
    animation: scroll-left 60s linear infinite;
    will-change: transform;
  }
  .marquee.fast .marquee-track { animation-duration: 32s; }
  .marquee.slow .marquee-track { animation-duration: 90s; }
  .marquee-track span {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }
  .marquee-track span::before {
    content: '★';
    color: var(--accent);
  }
  .marquee.headline .marquee-track span {
    font-family: 'Major Mono Display', monospace;
    font-size: clamp(40px, 7vw, 90px);
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--fg);
    gap: 28px;
  }
  .marquee.headline .marquee-track span::before {
    content: '/';
    color: var(--accent);
    font-family: 'Major Mono Display', monospace;
  }
  .marquee.headline { padding: 36px 0; }
  .marquee.alt { background: var(--bg); }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ─── Services (static grid) ─── */
  .services {
    padding: 120px 32px 80px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .svc-group + .svc-group {
    margin-top: 96px;
    padding-top: 96px;
    border-top: 1px solid var(--rule);
  }
  .svc-head {
    margin-bottom: 56px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    align-items: end;
  }
  .svc-tag {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .svc-head h2 {
    font-family: 'Newsreader', serif;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-top: 10px;
  }
  .svc-head .lede {
    color: var(--dim);
    font-size: 14px;
    line-height: 1.6;
    max-width: 380px;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .svc {
    border-left: 1px solid var(--rule);
    padding: 4px 0 4px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.2s ease;
  }
  .svc:hover { border-left-color: var(--accent); }
  .svc-num {
    font-family: 'Major Mono Display', monospace;
    font-size: 22px;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .svc h3 {
    font-family: 'Newsreader', serif;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .svc p {
    color: var(--dim);
    font-size: 13px;
    line-height: 1.7;
    flex: 1;
  }
  .svc-meta {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px dashed var(--rule);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg);
    opacity: 0.7;
  }

  @media (max-width: 800px) {
    .services { padding: 80px 20px; }
    .svc-head { grid-template-columns: 1fr; gap: 12px; margin-bottom: 32px; }
    .svc-grid { grid-template-columns: 1fr; gap: 24px; }
    .svc { padding-left: 18px; }
  }

  /* ─── Stat row ─── */
  .stats {
    padding: 120px 32px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .stat {
    border-left: 1px solid var(--rule);
    padding-left: 24px;
  }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .stat .label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .stat .value {
    font-family: 'Major Mono Display', monospace;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stat .unit {
    margin-top: 12px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* ─── CTA ─── */
  .cta-row {
    padding: 120px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }
  .cta-row .stamp {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cta-row h2 {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(24px, 3.4vw, 40px);
    line-height: 1.25;
    max-width: 760px;
    letter-spacing: -0.01em;
  }
  .cta {
    display: inline-block;
    padding: 14px 26px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--accent); color: var(--accent-on); }

  /* ─── Footer ─── */
  footer {
    padding: 28px 32px 56px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    gap: 20px;
    flex-wrap: wrap;
  }
  footer a:hover { color: var(--accent); }

  /* ─── Responsive ─── */
  @media (max-width: 800px) {
    /* bilingual header carries a 4th control and longer French labels;
       wrap rather than overflow the viewport horizontally */
    .top { padding: 18px 20px; flex-wrap: wrap; gap: 10px 14px; }
    /* drop margin-left:auto so items pack two-per-row instead of one */
    .top nav { gap: 14px; font-size: 10px; margin-left: 0; }
    .lang-switch, .theme-toggle { padding: 5px 7px; font-size: 9px; }
    .hero { padding: 0 20px; }
    .hscroll-panel { grid-template-columns: 1fr; padding: 80px 20px; gap: 24px; }
    .hscroll-panel .h-tag { left: 20px; }
    .hscroll-progress { left: 20px; right: 20px; }
    .stats { grid-template-columns: 1fr 1fr; padding: 80px 20px; gap: 28px; }
    .stat { padding-left: 16px; }
    .stat:nth-child(3) { border-left: 0; padding-left: 0; }
    .cta-row, footer { padding-left: 20px; padding-right: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark, .hero .sub { opacity: 1; transform: none; animation: none; }
    .atom .o1, .atom .o2, .atom .o3 { animation: none; }
    .hero::after { width: 100%; animation: none; }
    .marquee-track { animation: none; }
  }
</style>{% endraw %}
</head>
<body>

<header class="top">
  <a class="brand" href="/{{ lang }}/">ATOMSTAR</a>
  <nav>
    <a href="#work">{{ t.nav.work }}</a>
    <a href="#engage">{{ t.nav.engage }}</a>
  </nav>
  <a class="lang-switch" href="/{{ other }}/" hreflang="{{ other }}" data-lang-switch="{{ other }}" aria-label="{{ t.langSwitch.aria }}">{{ t.langSwitch.label }}</a>
  <button class="theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
    <span data-theme-label="dark">{{ t.theme.dark }}</span>
    <span class="sep">·</span>
    <span data-theme-label="light">{{ t.theme.light }}</span>
  </button>
</header>

<!-- ─── HERO ─── -->
<section class="hero">
  <div class="eyebrow">{{ t.hero.eyebrow }}</div>
  <div class="mark">
    <svg class="atom" viewBox="0 0 100 100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="50" r="46" class="ring"/>
      <g class="o1"><ellipse cx="50" cy="50" rx="40" ry="14" class="orbit"/></g>
      <g class="o2"><ellipse cx="50" cy="50" rx="40" ry="14" class="orbit" transform="rotate(60 50 50)"/></g>
      <g class="o3"><ellipse cx="50" cy="50" rx="40" ry="14" class="orbit" transform="rotate(-60 50 50)"/></g>
      <circle cx="50" cy="50" r="8" class="core"/>
    </svg>
    <h1 class="wordmark"><span>atom</span><span class="accent">star</span></h1>
  </div>
  <p class="sub">{{ t.hero.sub }}</p>
</section>

<!-- ─── MARQUEE 1 — disclosure feed ─── -->
<div class="marquee fast" aria-hidden="true" id="feed">
  <div class="marquee-track">
    {% for item in site.feed %}<span>{{ item }}</span>
    {% endfor %}{% for item in site.feed %}<span>{{ item }}</span>
    {% endfor %}
  </div>
</div>

<!-- ─── SERVICES — what we do ─── -->
<section class="services" id="work">
{% for group in [t.services.consulting, t.services.offensive] %}
  <div class="svc-group">
    <header class="svc-head">
      <div>
        <span class="svc-tag">{{ group.tag }}</span>
        <h2>{{ group.title }}</h2>
      </div>
      <p class="lede">{{ group.lede }}</p>
    </header>

    <div class="svc-grid">
      {% for c in group.cards %}
      <article class="svc">
        <div class="svc-num">{{ c.num }}</div>
        <h3>{{ c.title }}</h3>
        <p>{{ c.body }}</p>
        <div class="svc-meta">{{ c.meta }}</div>
      </article>
      {% endfor %}
    </div>
  </div>
{% endfor %}
</section>

<!-- ─── STATS ─── -->
<section class="stats" id="stats">
  {% for s in t.stats %}{% set v = site.statValues[loop.index0] %}
  <div class="stat">
    <div class="label">{{ s.label }}</div>
    {% if v.static %}<div class="value">{{ v.static | safe }}</div>
    {% else %}<div class="value" data-count="{{ v.count }}"{% if v.decimals %} data-decimals="{{ v.decimals }}"{% endif %}>0</div>
    {% endif %}
    <div class="unit">{{ s.unit }}</div>
  </div>
  {% endfor %}
</section>

<!-- ─── MARQUEE 2 — manifesto headline ─── -->
<div class="marquee headline slow alt" aria-hidden="true">
  <div class="marquee-track">
    <span>{{ t.marquee }}</span>
    <span>{{ t.marquee }}</span>
    <span>{{ t.marquee }}</span>
    <span>{{ t.marquee }}</span>
  </div>
</div>

<!-- ─── CTA ─── -->
<section class="cta-row" id="engage">
  <div class="stamp">{{ t.cta.stamp }}</div>
  <h2>{{ t.cta.title }}</h2>
  <a class="cta" href="mailto:{{ site.email }}">{{ site.email }} →</a>
</section>

<footer>
  <span>{{ t.footer.left }}</span>
  <span>{{ t.footer.right }}</span>
</footer>

{% raw %}<script>
(() => {
  // Theme toggle — DARK ↔ LIGHT. Persists to localStorage.
  const html = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]');
  const order = ['dark', 'light'];
  const bgFor = { dark: '#0a0a0a', light: '#efe7d6' };
  const current = () => order.includes(html.dataset.theme) ? html.dataset.theme : 'dark';
  const sync = () => {
    const cur = current();
    for (const t of order) {
      const el = toggle?.querySelector(`[data-theme-label="${t}"]`);
      if (el) el.classList.toggle('active', cur === t);
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', bgFor[cur]);
  };
  sync();
  toggle?.addEventListener('click', () => {
    const next = order[(order.indexOf(current()) + 1) % order.length];
    html.dataset.theme = next;
    try { localStorage.setItem('atomstar-theme', next); } catch (e) {}
    sync();
  });

  // Count-up animation for stats, triggered when in view.
  const stats = document.querySelectorAll('[data-count]');
  const ease = (t) => 1 - Math.pow(1 - t, 3);
  const animate = (el) => {
    const target = parseFloat(el.dataset.count);
    const decimals = parseInt(el.dataset.decimals || '0', 10);
    const duration = 1400;
    const start = performance.now();
    const tick = (now) => {
      const t = Math.min(1, (now - start) / duration);
      const v = target * ease(t);
      el.textContent = decimals
        ? v.toFixed(decimals)
        : Math.round(v).toLocaleString();
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          animate(e.target);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.4 });
    stats.forEach(s => io.observe(s));
  } else {
    stats.forEach(animate);
  }
})();
</script>{% endraw %}
<script>
(() => {
  // Remember a deliberate language choice so the shim at / honours it.
  document.querySelectorAll('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('atomstar-lang', a.dataset.langSwitch); } catch (e) {}
    });
  });
})();
</script>
</body>
</html>
